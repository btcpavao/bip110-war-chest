{
  "name": "bip110-war-chest-site",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "bip110warchest.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
